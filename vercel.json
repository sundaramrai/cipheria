{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs"
    },
    "api": {
      "root": "api",
      "entrypoint": "index:app",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path(.*)?",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
